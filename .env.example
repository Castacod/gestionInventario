# Copiar a api/.env y web/.env.local (los valores son ejemplos; usa los tuyos en los archivos reales, no subas .env al repo)

# -----------------------------------------------------------------------------
# API — archivo: api/.env
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase: Postgres directo (node-pg). Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
PG_SSL=true

# Opcional: mismo proyecto en servidor si usas @supabase/supabase-js en la API (no exponer al cliente)
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[service_role_secret]

JWT_SECRET=cambia_esto_por_un_secreto_largo_aleatorio

# MongoDB Atlas (URI real solo en api/.env; aquí solo placeholder)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=academic_demo

REDIS_URL=redis://127.0.0.1:6379
ALLOW_REDIS_FLUSH=true

# -----------------------------------------------------------------------------
# Next.js — archivo: web/.env.local (variables NEXT_PUBLIC_* se inyectan en el bundle; no pongas secretos)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (cliente browser / SSR público): Dashboard → Project Settings → API
# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# Clave publicable / anon (segura para el front; no es la service_role)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=[tu_clave_publicable_o_anon]

# Notas:
# - NEXT_PUBLIC_SUPABASE_* solo sirve si usas @supabase/supabase-js en el front (Realtime, Auth helpers, etc.).
# - La API actual usa principalmente DATABASE_URL + JWT + Redis; las claves de arriba no sustituyen DATABASE_URL en el servidor.
